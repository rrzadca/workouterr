{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"],
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "workouterr": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/workouterr",
      "sourceRoot": "projects/workouterr/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/workouterr/src/main.ts",
            "tsConfig": "projects/workouterr/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/workouterr/public"
              }
            ],
            "styles": ["projects/workouterr/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "projects/workouterr/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "workouterr:build:production"
            },
            "development": {
              "buildTarget": "workouterr:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "setupFiles": ["projects/ui/testing/html-dialog.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/workouterr/**/*.ts", "projects/workouterr/**/*.html"],
            "eslintConfig": "projects/workouterr/eslint.config.js"
          }
        }
      }
    },
    "ui": {
      "projectType": "library",
      "root": "projects/ui",
      "sourceRoot": "projects/ui/src",
      "prefix": "rad",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ui/tsconfig.spec.json",
            "setupFiles": ["projects/ui/testing/html-dialog.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/ui/**/*.ts", "projects/ui/**/*.html"],
            "eslintConfig": "projects/ui/eslint.config.js"
          }
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": "projects/ui/.storybook",
            "port": 6006,
            "styles": ["projects/ui/src/styles/global.css"],
            "tsConfig": "projects/ui/.storybook/tsconfig.json"
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": "projects/ui/.storybook",
            "outputDir": "dist/storybook",
            "styles": ["projects/ui/src/styles/global.css"],
            "tsConfig": "projects/ui/.storybook/tsconfig.json"
          }
        }
      }
    }
  }
}
