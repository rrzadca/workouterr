root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.cs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# EF Core migrations are generated: formatters and analyzers leave them as EF writes them.
[**/Migrations/*.cs]
generated_code = true
