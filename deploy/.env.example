# Copy to .env beside compose.yaml and fill in; on the server: chmod 600 .env.

# The database password, set when the postgres-data volume is first created (changing it later needs ALTER ROLE).
POSTGRES_PASSWORD=

# The domain Caddy serves and gets a certificate for; leave it unset to run locally on https://localhost.
# WORKOUTERR_DOMAIN=workouterr.example.com
