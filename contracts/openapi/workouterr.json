  "components": {
    "schemas": {
      "CurrentUserResponse": {
        "required": [
          "id",
          "email"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "ExerciseInRoutinesProblem": {
        "required": [
          "routines"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "routines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoutineReference"
            }
          }
        }
      },
      "ExerciseRequest": {
        "required": [
          "name",
          "metrics",
          "muscleGroups"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "metrics": {
            "$ref": "#/components/schemas/TrackedMetrics"
          },
          "muscleGroups": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MuscleGroup"
            }
          },
          "description": {
            "maxLength": 2000,
            "type": [
              "null",
              "string"
            ]
          },
          "weightStep": {
            "multipleOf": 0.01,
            "maximum": 100,
            "minimum": 0.01,
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "timeStepSeconds": {
            "maximum": 600,
            "minimum": 1,
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "perSide": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ExerciseResponse": {
        "required": [
          "id",
          "name",
          "description",
          "metrics",
          "weightStep",
          "timeStepSeconds",
          "perSide",
          "muscleGroups",
          "isArchived"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "metrics": {
            "$ref": "#/components/schemas/TrackedMetrics"
          },
          "weightStep": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "timeStepSeconds": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "perSide": {
            "type": "boolean"
          },
          "muscleGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MuscleGroup"
            }
          },
          "isArchived": {
            "type": "boolean"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "HealthStatus": {
        "enum": [
          "Unhealthy",
          "Degraded",
          "Healthy"
        ]
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "password": {
