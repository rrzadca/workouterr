{
  "name": "@workouterr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env public_nodejs/app.js",
    "start:dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "node --env-file-if-exists=.env src/test-support/migrate-test-database.ts",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "prisma": "^7.10.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@workouterr/shared": "*",
    "express": "^5.3.0",
    "zod": "^4.6.5"
  }
}
