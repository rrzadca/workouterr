{
  "name": "workouterr",
  "private": true,
  "workspaces": [
    "shared",
    "api",
    "web",
    "ui"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
