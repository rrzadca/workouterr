{
  "name": "@radinf/ui",
  "version": "0.0.1",
  "description": "Angular UI components styled with Tailwind CSS",
  "scripts": {
    "build": "ng build",
    "typecheck": "ngc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "ng test --watch=false",
    "storybook": "ng run ui:storybook",
    "build-storybook": "ng run ui:build-storybook"
  },
  "peerDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular-devkit/architect": "^0.2202.2",
    "@angular-devkit/core": "^22.2.2",
    "@angular/animations": "^22.2.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "postcss": "^8.5.3",
    "rxjs": "~7.8.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.1.12",
    "vitest": "^5.0.0"
  },
  "sideEffects": false
}
