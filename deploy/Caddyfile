# One site: the Angular app and, under /api, the API. HTTPS is automatic: a Let's Encrypt certificate for a public
# domain, a certificate from Caddy's own local authority for `localhost`.
{$WORKOUTERR_DOMAIN:localhost} {
	encode zstd gzip

	# The API checks Origin against Host (CSRF guard), so Host passes through unchanged (reverse_proxy's default).
	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv

		# File names with Angular's content hash never change their content, so they are cached for a year. A missing
		# one (an old tab asking for a chunk the last deploy removed) is a plain 404: no index.html fallback and no
		# cache header, so the year-long cache never holds the wrong file.
		@hashed path_regexp -[0-9A-Za-z]{8}\.(js|css|woff2?)$
		handle @hashed {
			@exists file
			header @exists Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Everything else (index.html, translations, icons) is checked on every load, so a deploy is picked up at
		# once. Client-side routes (/login, …) are served index.html; Angular's router takes it from there.
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
